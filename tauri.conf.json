{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OneKeyMouse",
  "version": "0.1.0",
  "identifier": "com.onekeymouse.app",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [],
    "targets": ["dmg", "nsis"],
    "category": "Utility",
    "shortDescription": "Одна клавиатура и мышь для Mac и Windows",
    "longDescription": "Объединяет Windows и Mac в одну рабочую область по локальной сети с помощью Deskflow.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
