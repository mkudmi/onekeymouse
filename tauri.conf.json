{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OneKeyMouse",
  "version": "0.2.0",
  "identifier": "com.onekeymouse.desktop",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": [
      "dmg",
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "Одна клавиатура и мышь для Mac и Windows",
    "longDescription": "Объединяет Windows и Mac через собственный сетевой движок OneKeyMouse.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": false
      }
    },
    "publisher": "mkudmi"
  }
}
